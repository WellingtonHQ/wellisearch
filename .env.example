# wellisearch .env.example — placeholders only. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.

# --- postgres (host "postgres" = network alias of the shared infra container) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=wellington
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wellisearch

# --- crawl4ai (existing Crawl4AI API server; host-routable URL from the container) ---
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_API_KEY=change-me

# --- search providers (failover pool + default order; the dashboard can
#     override the order at runtime, and "reset to default" returns here) ---
SEARCH_PROVIDERS=tavily,brave,exa,youcom
TAVILY_API_KEY=change-me                    # ~1,000 free credits/mo, no card
TAVILY_QUOTA_MONTHLY=1000                   # 0/unset = unknown; gateway still fails over on 429
BRAVE_API_KEY=change-me                     # ~1,000 queries/mo ($5 credits, card required)
BRAVE_QUOTA_MONTHLY=1000
EXA_API_KEY=change-me                       # ~1,000 free credits/mo (search), no card
EXA_QUOTA_MONTHLY=1000
YOUCOM_API_KEY=change-me                    # credit-based; new accounts get $100 credits
YOUCOM_QUOTA_MONTHLY=1000
PROVIDER_TIMEOUT_S=20

# --- embeddings — single source of truth; worker and server must always use the same model ---
# Changing this invalidates all stored vectors: run `python -m wellisearch.reindex`.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMS=384

# --- search ---
SEARCH_K=5
SEARCH_MAX_CRAWL=5
SEARCH_MIN_SCORE=0.12
STALE_HOURS=72
MAX_CHUNK_TOKENS=800

# --- fetch_pages truncation (swappable strategies) ---
FETCH_DEFAULT_STRATEGY=smart                # smart | head | tail | even | priority
FETCH_MAX_CHARS=40000                       # default total budget when max_chars omitted (0 = unlimited)
FETCH_PER_PAGE_CHARS=12000                  # default per-page cap

# --- worker / queue (async indexing) ---
WORKER_INTERVAL_MIN=30
WORKER_BUDGET_PER_RUN=25
WORKER_TICK_BUDGET_MIN=15
KICK_DEBOUNCE_S=5
QUEUE_MAX_ATTEMPTS=3
CRAWL_TIMEOUT_S=45
CRAWL_MAX_PARALLEL=8

# --- server ---
BIND_PORT=8780
# Optional API auth for REST + MCP (empty = open). When set, clients send
# "Authorization: Bearer <key>" or "X-API-Key: <key>".
WELLISEARCH_API_KEY=
