# wellisearch .env.example — placeholders only. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys. Service keys all have defaults in
# src/wellisearch/config.py (that file's section order is mirrored below); the
# Benchmarks section covers env vars read by benchmarks/llm_md_cleanup_bench.py.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

DB_POOL_MAX_SIZE=24                      # db.py AsyncConnectionPool ceiling (tick bursts + concurrent fetches)
DB_POOL_MIN_SIZE=2                       # pool floor kept warm for the search path
DB_POOL_TIMEOUT_S=10                     # max wait for a pooled connection before failing "database busy"
POSTGRES_ADMIN_DB=postgres               # maintenance DB used only to self-create POSTGRES_DB at startup
POSTGRES_DB=wellisearch                  # database for pages/chunks/vectors/logs
POSTGRES_HOST=<postgres-host>            # any resolvable name or IP this container can reach
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_USER=wellington

# ---------------------------------------------------------------------------
# Search Providers
# ---------------------------------------------------------------------------

BRAVE_API_KEY=***                       # ~1,000 queries/mo ($5 credits, card required)
BRAVE_QUOTA_MONTHLY=1000                 # 0/unset = unknown; gateway still fails over on 429
EXA_API_KEY=change-me                    # ~1,000 free credits/mo (search), no card
EXA_QUOTA_MONTHLY=1000
PROVIDER_TIMEOUT_S=20
SEARCH_PROVIDERS=tavily,brave,exa,youcom # failover order - priority order, not alphabetical; the dashboard can override it at runtime ("reset to default" returns here)
TAVILY_API_KEY=change-me                 # ~1,000 free credits/mo, no card
TAVILY_QUOTA_MONTHLY=1000                # 0/unset = unknown; gateway still fails over on 429
YOUCOM_API_KEY=change-me                 # credit-based; new accounts get $100 credits
YOUCOM_QUOTA_MONTHLY=1000

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------

# Single source of truth: worker and server must always use the same model.
# Changing it invalidates all stored vectors - run `python -m wellisearch.reindex`.
EMBED_DIMS=384                           # must match EMBED_MODEL's output dimensionality
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_THREADS=2                          # ORT intra-op threads per embedding session (unbounded oversubscribes the host)

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

LOCAL_MIN_COVERAGE=0.75                  # local-hit gate: a passing row must cover >= this fraction of query words (docs/ranking.md)
LOCAL_MIN_SIMILARITY=0.3                 # local-hit gate: a passing row's best-chunk cosine similarity must be >= this; NULL never passes
SEARCH_GATE_MIN_K=10                     # fetch at least this many rows so the gate can see near-miss pages; auto mode defers to providers if fewer than k rows pass
SEARCH_K=5                               # results returned to callers
SEARCH_MAX_CRAWL=5                       # max URLs enqueued for crawling on a local miss
SEARCH_MIN_SCORE=0.06                    # legacy local-hit cutoff; now only for ranking (docs/ranking.md)
SEARCH_STATEMENT_TIMEOUT_MS=15000        # per-statement backstop for the local search SQL; a timeout falls back to the provider gateway
STALE_HOURS=72                           # pages older than this are eligible to be re-crawled

# ---------------------------------------------------------------------------
# Fetch (on-demand read path + truncation)
# ---------------------------------------------------------------------------

FETCH_DEFAULT_STRATEGY=smart             # smart | head | tail | even | priority
FETCH_MAX_CHARS=40000                    # default total budget when max_chars omitted (0 = unlimited)
FETCH_PER_PAGE_CHARS=12000               # default per-page cap
FETCH_PROBE_TIMEOUT_S=15                 # per-tier timeout cap while a fetch crawls on demand (worker always uncapped)
FETCH_TIMEOUT_S=45                       # hard deadline for one on-demand crawl; past it the URL is re-queued for the worker
FETCH_ORPHAN_GRACE_S=15                 # grace after an abandoned probe's client leaves, before we stop it (default = one per-tier budget)

# ---------------------------------------------------------------------------
# Worker / Queue
# ---------------------------------------------------------------------------

CRAWL_MAX_PARALLEL=8                     # fast-lane crawl concurrency
CRAWL_TIMEOUT_S=45                       # wall-clock budget per URL in the crawl lanes
KICK_DEBOUNCE_S=5                        # min gap between manual seed/refresh kicks reaching the worker
LOG_RETENTION_DAYS=90                    # event_log / crawl_log / search_log prune age
QUEUE_MAX_ATTEMPTS=3                     # retries before a queued URL is given up on
REFRESH_BACKOFF_BASE_HOURS=6             # failing refreshes back off 6h x 2^streak, capped at REFRESH_MIN_AGE_HOURS
REFRESH_MIN_AGE_HOURS=72                 # watchlist page is eligible for refresh after this age
WORKER_BUDGET_PER_RUN=25                 # max pages crawled per tick (queue lane)
WORKER_INTERVAL_MIN=30                   # how often the worker wakes to crawl queued URLs / refresh the watchlist
WORKER_TICK_BUDGET_MIN=15                # wall-clock cap for one full tick

# ---------------------------------------------------------------------------
# Native Crawl Engine
# ---------------------------------------------------------------------------

CRAWL_CF_POOL_SIZE=1                     # CF (challenge) lane: dedicated low-concurrency browser pool
CRAWL_CF_TIMEOUT_S=300                   # high per-page timeout for the challenge loop
CRAWL_CHALLENGE_BUDGET_S=40              # per-page budget of the CF turnstile resolve loop
CRAWL_CHALLENGE_PARALLEL=2               # concurrent slots in the challenge loop
CRAWL_HEADLESS=false                     # run real headed Chrome under Xvfb (container setups)
CRAWL_HTTP_TIER=true                     # tier 1: plain HTTP fetch before any browser work
CRAWL_IGNORE_SSL_ERRORS=true             # tiers only fetch public read-only pages, so untrusted TLS certs are accepted by default; false = strict verification
CRAWL_LAUNCH_RETRY_AFTER_S=30            # relaunch backoff after a failed browser launch (keep equal to entrypoint.sh Xvfb self-heal poll)
CRAWL_MD_MAX_CHARS=150000                # max markdown characters extracted per page before chunking
CRAWL_POOL_SIZE=3                        # fast-lane browser pool size
CRAWL_PROFILE_DIR=/profiles              # persistent browser profile storage dir
CRAWL_PROFILE_MAX=8                      # max retained browser profiles before the oldest are evicted
CRAWL_SETTLE_S=2.0                       # extra wait after network-idle for late JS paints (search results, SPAs)
CRAWL_STEALTH_TIER=true                  # tier 3: stealth (patchright) browsers for tough pages
CRAWL_STEALTH_TIMEOUT_S=120              # wall-clock budget per URL in the stealth tier

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

BIND_PORT=8780                           # HTTP port exposed by the dashboard/API/MCP
WELLISEARCH_API_KEY=                     # optional API auth for REST + MCP (empty = open); when set, clients send "Authorization: Bearer <key>" or "X-API-Key: <key>"

# ---------------------------------------------------------------------------
# Benchmarks (benchmarks/llm_md_cleanup_bench.py)
# ---------------------------------------------------------------------------

# Not consumed by the service - read directly from this file by the LLM markdown-cleanup bench.
# The three JUDGE_* keys below are required to run it with a judge; every other BENCH_/OLLAMA_ knob defaults in-script (see its --help).
JUDGE_API_KEY=***                       # judge API key; keep it here, never in source
JUDGE_BASE_URL=<judge-endpoint>          # the 27B judge's OpenAI-compatible endpoint (or pass --judge-url)
JUDGE_MODEL=qwen3.8-27b                  # default model name sent to JUDGE_BASE_URL
